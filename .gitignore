# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ======== Secrets and signing: never commit ========
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.der
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
!debug.keystore
id_rsa*
id_ed25519*
credentials.json
secrets.json
service-account*.json
GoogleService-Info.plist
google-services.json
# Personal Claude Code settings (the shared .claude/settings.json is fine)
.claude/settings.local.json

# ======== Generated native projects (Continuous Native Generation) ========
# They hold your signing team and bundle id: Expo regenerates them on build
/ios
/android

# ======== The engine (engine/build-*.sh) ========
# Upstream TuringDB, fetched at the pinned commit, and the builds (~GBs)
/engine/turingdb
/engine/build
# The built engine is ~100 MB: copied in by scripts/sync-engine.sh, never committed
*.xcframework
compile_commands.json

# ======== Dependencies and tooling ========
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo
.kotlin/
*.orig.*
coverage/

# ======== Logs and editors ========
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.idea/
.vscode/

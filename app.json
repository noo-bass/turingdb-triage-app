{
  "expo": {
    "name": "Triage",
    "slug": "triage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.edthtriage"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.edthtriage"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Triage uses the camera to take a photo of each casualty, so you can tell them apart. Photos stay on this phone.",
          "photosPermission": "Triage can use a photo you already took to identify a casualty. Photos stay on this phone."
        }
      ]
    ],
    "backgroundColor": "#000000",
    "scheme": "triage"
  }
}
